rules_version = '2';

// Firebase Storage rules for Givny.
//
// Deploy with:  firebase deploy --only storage
//
// The important rule here is `verifications/`: those objects are photographs of
// national ID cards. They are write-only from the client — nobody can read them
// back over the client SDK, including the person who uploaded them. Reviewers
// see them through short-lived signed URLs minted server-side by the Admin SDK,
// which bypasses these rules, and the object is deleted once a decision is made.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function withinSizeLimit() {
      // Inclusive, to match the client's "up to 8 MB": react-dropzone accepts a
      // file of exactly 8 MB, and a stricter rule here would reject an upload
      // the picker had already allowed.
      return request.resource.size <= 8 * 1024 * 1024;
    }

    // Listing photos — shown to everyone browsing, so public read.
    match /donor/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && withinSizeLimit();
    }

    // Profile avatars — public read, owner write.
    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && withinSizeLimit();
    }

    // Blog images — public by definition: they appear on published pages and in
    // link previews. Writes are scoped to the uploader's own folder.
    //
    // These rules cannot see Firestore roles, so this permits any signed-in
    // member to write under their own uid rather than only blog authors. The
    // editor is the sole caller and is gated on blog.manage; the residual risk
    // is a member using the bucket as image hosting, which the size cap bounds.
    match /blog/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && withinSizeLimit();
    }

    // Chat attachments — signed-in only, never public.
    match /messages/{requestId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && withinSizeLimit();
    }

    // Identity documents — WRITE ONLY. No client read path exists at all.
    match /verifications/{uid}/{allPaths=**} {
      allow read: if false;
      allow create: if isOwner(uid) && isImage() && withinSizeLimit();
      allow update, delete: if false;   // server-side cleanup only
    }

    // CVs. Anyone may attach one when applying — requiring an account to apply
    // would cost real candidates — but nobody can read them back over the
    // client SDK. Reviewers use short-lived signed URLs minted server-side.
    match /resumes/{jobId}/{allPaths=**} {
      allow read: if false;
      allow create: if request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches(
                         "application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)");
      allow update, delete: if false;   // server-side cleanup only
    }

    // Anything not matched above is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
